# --- LLM / chat model ---
OPENAI_API_KEY=your-api-key
BASE_URL=api-base-url
# Optional: override the chat model (defaults to claude-opus-5)
CHAT_MODEL=claude-opus-5

# --- Google Calendar OAuth ---
# Create these in Google Cloud Console (see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Calendar behaviour (optional) ---
# Default duration in minutes for timed events with no explicit end time.
DEFAULT_EVENT_DURATION_MINUTES=90
# Optional IANA timezone (e.g. Asia/Dhaka, America/New_York).
# If unset, the server's local UTC offset is used.
CALENDAR_TIMEZONE=
